---
import Layout from '../layouts/Layout.astro';

const ctaClass = "mt-7 inline-block rounded-sm bg-teal-deep px-6 py-3 text-xs uppercase tracking-eyebrow text-warm-white";
---

<Layout title="Page not found — Healthgarden">
  <section class="px-6 py-20 text-center">
    <p class="text-xs uppercase tracking-wide-label text-sage">Page not found</p>
    <h1 class="mt-4 font-serif text-3xl italic leading-tight text-teal-deep md:text-4xl">
      This page doesn't exist
    </h1>
    <p class="mx-auto mt-5 max-w-md text-sm text-slate-body">
      The link may be out of date, or the address may have a typo. You can start again from the home page, or reach out directly.
    </p>
    <a href="/" class={ctaClass}>Back to home</a>
  </section>
</Layout>
