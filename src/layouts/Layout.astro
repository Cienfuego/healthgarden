---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  current?: string;
  footerMeta?: string;
}

const {
  title,
  description = "Independent nurse practitioner advocacy for complex care decisions, serious diagnoses, and the questions no one has time to answer.",
  current,
  footerMeta,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Healthgarden" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
     <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-88DVCQLXST"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-88DVCQLXST');
    </script> 
  </head>
  <body class="min-h-screen">
    <Nav current={current} />
    <slot />
    <Footer meta={footerMeta} />
  </body>
</html>
