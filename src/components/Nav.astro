---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
const { current } = Astro.props;

const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/services.html', label: 'Services', key: 'services' },
  { href: '/about.html', label: 'About', key: 'about' },
  { href: '/contact.html', label: 'Contact', key: 'contact' },
];
---
<nav class="border-b border-border-soft px-5 py-3 md:px-10 md:py-4">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-3 md:flex-row md:justify-between lg:max-w-5xl xl:max-w-6xl">
    <a href="/" class="shrink-0"><Image src={logo} alt="Healthgarden — Cultivating thoughtful care" widths={[300, 600]} sizes="(min-width: 768px) 15rem, 17rem" class="h-12 w-auto" /></a>
    <div class="flex gap-4 text-[11px] uppercase tracking-eyebrow sm:gap-5 sm:text-xs md:gap-6">
      {links.map(link => (
      <a
          href={link.href}
          class={current === link.key ? 'text-teal-deep' : 'text-slate-body hover:text-teal-deep'}
        >{link.label}</a>
      ))}
    </div>
      <a href="https://healthgarden.clientsecure.me" target="_blank" rel="noopener" class="rounded-full border border-teal-deep px-3 py-1.5 text-[10px] uppercase tracking-eyebrow text-teal-deep sm:text-xs">Client Portal</a>
  </div>
</nav>
