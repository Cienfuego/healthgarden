---
import { Image } from 'astro:assets';
import logoReversed from '../assets/logo-reversed.png';

const { meta } = Astro.props;
---

<footer class="bg-teal-deep px-5 py-10 text-center">
  <Image src={logoReversed} alt="Healthgarden — Cultivating thoughtful care" widths={[400, 800]} sizes="(min-width: 768px) 20rem, 15rem" class="mx-auto h-14 w-auto md:h-16" />
  {meta && (
    <div class="mt-5 text-xs tracking-eyebrow text-teal-light">{meta}</div>
  )}
  <div class="mt-4">
    <a href="/privacy.html" class="text-xs uppercase tracking-eyebrow text-teal-light">Privacy</a>
  </div>
</footer>
