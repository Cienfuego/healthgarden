---
const { meta } = Astro.props;
---

<footer class="bg-teal-deep px-5 py-8 text-center">
  <div class="font-serif text-2xl text-warm-white">Healthgarden</div>
  <div class="mt-1 font-serif text-base italic text-sage">Cultivating thoughtful care.</div>
  {meta && (
    <div class="mt-3 text-xs tracking-eyebrow text-teal-light">{meta}</div>
  )}
</footer>
